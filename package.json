{
  "name": "cs-demo-review",
  "version": "0.1.0-beta.2",
  "private": true,
  "description": "Local Counter-Strike demo replay and evidence review",
  "author": "CS Demo Review",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "build:app": "vite build && node scripts/build-electron.mjs",
    "build": "npm run typecheck && npm run build:worker && node scripts/licenses.mjs && npm run build:app",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:worker": "node scripts/test-worker.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test:telemetry": "node scripts/test-telemetry.mjs",
    "start": "electron .",
    "package": "npm run build && electron-builder --win nsis zip --publish never && node scripts/checksums.mjs",
    "preview": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.csdemoreview.app",
    "productName": "CS Demo Review",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.ico",
      "build/THIRD-PARTY-LICENSES.txt",
      "THIRD-PARTY-NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "worker/bin",
        "to": "worker",
        "filter": [
          "*.exe"
        ]
      },
      {
        "from": ".tools/source2viewer",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "artifactName": "CS-Demo-Review-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": null
  }
}
